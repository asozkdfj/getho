# ---------------------------------------------------------------------------
# EPL Edge Lab - environment template
# Copy to `.env` for local overrides. docker compose works WITHOUT a .env file
# (safe local defaults are baked into docker-compose.yml).
# Never commit real secrets. `.env` is git-ignored.
# Keep comments on their own lines: docker compose reads text after an EMPTY
# value (KEY=   # note) as the value itself.
# ---------------------------------------------------------------------------

# --- Runtime ---
# local | ci | staging | production
APP_ENV=local
LOG_LEVEL=INFO

# --- Database (all timestamps are stored in UTC) ---
POSTGRES_USER=edge
# local only - change everywhere else
POSTGRES_PASSWORD=edge
POSTGRES_DB=edge
DATABASE_URL=postgresql+psycopg://edge:edge@localhost:5432/edge
# Used by pytest for DB-backed tests (database is truncated by tests!)
TEST_DATABASE_URL=postgresql+psycopg://edge:edge@localhost:5432/edge_test

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0

# --- Data provider ---
# mock         : deterministic synthetic data, no key needed (default)
# api_football : API-Football / api-sports.io v3 (needs API_FOOTBALL_KEY)
# Each provider's data is kept separate (listing, training and predictions).
DATA_PROVIDER=mock
# Market-baseline bookmaker slug (lowercase, no spaces, e.g. bet365, pinnacle).
# Empty -> provider default (mock: mockbook, api_football: bet365).
PRIMARY_BOOKMAKER=

# --- API-Football (only when DATA_PROVIDER=api_football) ---
# secret: dashboard.api-football.com -> never commit
API_FOOTBALL_KEY=
# Premier League
API_FOOTBALL_LEAGUE_ID=39
# season start year, e.g. 2026; empty -> derived from date
API_FOOTBALL_SEASON=
# empty -> all bookmakers (same request count)
API_FOOTBALL_BOOKMAKER_ID=
# free plan ~10 req/min; ~0.3 on paid plans
API_FOOTBALL_MIN_INTERVAL_SECONDS=6.5
# Odds refresh ~every 3h upstream; 3h keeps a free plan at ~60 requests/day.
# worker schedule; use 10800 with api_football
PIPELINE_INTERVAL_SECONDS=1800

# --- Model metadata ---
# Recorded on every model_versions row. Docker builds pass the commit sha.
GIT_SHA=

# --- Startup behaviour (API container) ---
# local/dev convenience only, never in production
RUN_MIGRATIONS_ON_STARTUP=true
# Idempotent mock/API seed when the API container starts (local dev convenience).
# Set to false in production.
SEED_ON_STARTUP=true

# --- API ---
CORS_ORIGINS=http://localhost:3000
# Signal threshold: an outcome is flagged only if edge AND EV exceed it.
VALUE_THRESHOLD=0.03

# --- Web (Next.js) ---
# Server-side URL used by Next.js to reach the API (docker: http://api:8000)
API_INTERNAL_URL=http://localhost:8000
# Timezone used to decide what "today" means in the fixture list
DEFAULT_TZ=Asia/Seoul
