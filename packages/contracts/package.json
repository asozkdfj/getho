{
  "name": "@edge/contracts",
  "version": "0.1.0",
  "private": true,
  "description": "Shared API contract: types generated from the FastAPI OpenAPI schema + shared enums",
  "main": "src/index.ts",
  "types": "src/index.ts",
  "scripts": {
    "generate": "openapi-typescript openapi.json -o src/generated/api.ts",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "openapi-typescript": "^7.9.1",
    "typescript": "^5.9.2"
  }
}
