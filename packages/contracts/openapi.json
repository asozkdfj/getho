  "info": {
    "description": "EPL 1X2 확률 분석 API. 모델 확률·시장 공정확률·Edge·EV를 제공합니다. 확률은 추정치이며 결과를 보장하지 않습니다. 베팅 실행 기능은 없습니다.",
    "title": "EPL Edge Lab API",
    "version": "0.1.0"
  },
  "openapi": "3.1.0",
  "paths": {
    "/combinations/analyze": {
      "post": {
        "description": "Analyse 2-3 selections from *different* fixtures (independence approximation).",
        "operationId": "analyze_combinations_analyze_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CombinationRequest"
              }
            }
          },
          "required": true
        },
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CombinationOut"
                }
              }
            },
            "description": "Successful Response"
          },
          "422": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/ErrorOut"
                }
              }
            },
            "description": "Unprocessable Content"
          }
        },
        "summary": "Analyze",
        "tags": [
          "combinations"
        ]
      }
    },
    "/fixtures": {
      "get": {
        "operationId": "list_fixtures_fixtures_get",
        "parameters": [
          {
            "description": "Local date (YYYY-MM-DD) in `tz`. Default: today",
            "in": "query",
            "name": "date",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "format": "date",
                  "type": "string"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Local date (YYYY-MM-DD) in `tz`. Default: today",
              "title": "Date"
            }
          },
          {
            "description": "Number of days from `date`",
            "in": "query",
            "name": "days",
            "required": false,
            "schema": {
              "default": 1,
              "description": "Number of days from `date`",
              "maximum": 14,
              "minimum": 1,
              "title": "Days",
              "type": "integer"
            }
          },
          {
            "description": "IANA timezone used to interpret `date`",
            "in": "query",
            "name": "tz",
            "required": false,
            "schema": {
              "default": "UTC",
              "description": "IANA timezone used to interpret `date`",
              "title": "Tz",
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/FixtureListOut"
                }
              }
